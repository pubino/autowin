# Copy to .env (gitignored) and edit; `set -a; source .env; set +a` before running the scripts.

# Optional (defaults shown)
AUTOWIN_NAME=autowin
AUTOWIN_USER=tester
AUTOWIN_MEMORY=8192
AUTOWIN_CPUS=4
AUTOWIN_DISK_GB=64
AUTOWIN_TIMEOUT_MIN=90
# Wait for fetchwin's update packages, when the disc carries them (vm-create.sh --updates).
AUTOWIN_UPDATES_TIMEOUT_MIN=120
# Local state (generated password, provisioning disc), outside the repo.
AUTOWIN_STATE="$HOME/Library/Application Support/autowin"
