# Containerized lint, type, and test suite. Base image pinned by digest; Python
# dependencies pinned with hashes (requirements-dev.lock, exported from uv.lock).
FROM python:3.13.15-slim-bookworm@sha256:2325bb286ec344af3e5898cc224b5844e2707ac6e26b1632516fd3edc84a5e26

ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# zsh runs the example scripts against fake macOS tools (hdiutil, utmctl, osascript).
RUN apt-get update \
 && apt-get install -y --no-install-recommends zsh \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /work
COPY requirements-dev.lock .
RUN pip install --require-hashes --no-deps -r requirements-dev.lock

RUN useradd --create-home --uid 10001 tester && chown tester:tester /work
COPY --chown=tester:tester . .
USER tester
CMD ["sh", "tests/run_checks.sh"]
